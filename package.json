  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@wxt-dev/module-vue": "^1.0.2",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.6",
    "wxt": "^0.20.6"
  }
}